# Домен, на котором будет работать панель робота. DNS-запись типа A этого домена
# должна указывать на IP вашего сервера. Пример: robot.company.ru
DOMAIN=

# Всё остальное (Битрикс, Орбита, шаблоны, расписание) настраивается в панели в браузере.

# Необязательно:
# POLL_SECONDS=60       # как часто робот проверяет новые сделки и ответы
# DRY_RUN=1             # ничего не отправлять и не менять в Битриксе (для отладки)
