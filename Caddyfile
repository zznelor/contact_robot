# Адрес берётся из DOMAIN в .env. Сертификат HTTPS Caddy получит и продлит сам.
{$DOMAIN} {
	# Заголовки безопасности. Content-Security-Policy не задаём: стили и скрипт панели встроены в страницу
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "same-origin"
	}
	reverse_proxy app:8080
}
